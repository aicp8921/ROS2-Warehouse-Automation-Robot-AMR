<?xml version="1.0"?>
<robot name="my_first_robot">

    <link name="base_foot_link"/>

    <joint name="base_foot_to_base_joint" type="fixed">
        <parent link="base_foot_link"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="base_link">  
        <visual>    
            <geometry>
                <box size="0.4 0.3 0.1"/>
            </geometry>
            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>

        <collision>
            <geometry>
                <box size="0.4 0.3 0.1"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="10.0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0833" ixy="0.0" ixz="0.0" iyy="0.14" iyz="0.0" izz="0.25"/>
        </inertial>    
    </link>

    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <origin xyz="-0.1 0 0.05" rpy="0 0 0"/>
    </joint>

    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.02"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>

        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.05"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="4.0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0008"/>
        </inertial>

    </link>

    <joint name="wheel_joint_left" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_link_left"/>
        <origin xyz="0.1 -0.17 -0.05" rpy="1.5708 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="wheel_link_left">
        <visual>
            <geometry>
                <cylinder radius="0.08" length="0.04"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>

        <collision>
            <geometry>
                <cylinder radius="0.08" length="0.04"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="2.0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0008"/>
        </inertial>

    </link>

    <joint name="wheel_joint_right" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_link_right"/>
        <origin xyz="0.1 0.17 -0.05" rpy="1.5708 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="wheel_link_right">
        <visual>
            <geometry>
                <cylinder radius="0.08" length="0.04"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
         </visual>

        <collision>
            <geometry>
                <cylinder radius="0.08" length="0.04"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="2.0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.0002" iyz="0.0" izz="0.0008"/>
        </inertial>    

    </link>


    <joint name="caster_joint" type="continuous">
        <parent link="base_link"/>
        <child link="caster_link"/>
        <origin xyz="-0.15 0 -0.05" rpy="1 1 1"/>
        <axis xyz="1 1 1"/>
    </joint>

    <link name="caster_link">
        <visual>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
         </visual> 
         

        <collision>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
        </collision>

        <inertial>
            <mass value="1.0"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.00125"/>
        </inertial>
            
    </link>        

</robot>