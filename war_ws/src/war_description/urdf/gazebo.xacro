<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="war_robot"> 

    <!-- BASE CHASSIS -->
    <gazebo reference="base_link">
        <material>Gazebo/Red</material>
        <gravity>true</gravity>
        <self_collide>false</self_collide>
    </gazebo>

    <!-- DRIVE WHEELS (High friction for traction) -->
    <gazebo reference="left_wheel">
        <material>Gazebo/Black</material>
        <mu1>1.5</mu1>
        <mu2>1.5</mu2>
        <kp>1000000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
    </gazebo>

    <gazebo reference="right_wheel">
        <material>Gazebo/Black</material>
        <mu1>1.5</mu1>
        <mu2>1.5</mu2>
        <kp>1000000.0</kp>
        <kd>10.0</kd>
        <minDepth>0.001</minDepth>
    </gazebo>

    <!-- 4 BALL CASTERS (Near-zero friction for smooth omni sliding) -->
    <gazebo reference="front_left_caster_wheel">
        <material>Gazebo/Black</material>
        <mu1>0.001</mu1>
        <mu2>0.001</mu2>
    </gazebo>

    <gazebo reference="front_right_caster_wheel">
        <material>Gazebo/Black</material>
        <mu1>0.001</mu1>
        <mu2>0.001</mu2>
    </gazebo>

    <gazebo reference="rear_left_caster_wheel">
        <material>Gazebo/Black</material>
        <mu1>0.001</mu1>
        <mu2>0.001</mu2>
    </gazebo>

    <gazebo reference="rear_right_caster_wheel">
        <material>Gazebo/Black</material>
        <mu1>0.001</mu1>
        <mu2>0.001</mu2>
    </gazebo>

    <!-- CONVEYOR STRUCTURE IN GAZEBO -->
    <gazebo reference="conveyor_frame">
        <material>Gazebo/DarkGrey</material>
    </gazebo>

    <gazebo reference="conveyor_belt">
        <material>Gazebo/Green</material>
    </gazebo>

    <!-- 2D LIDAR RAY SENSOR -->
    <gazebo reference="lidar_link">
        <material>Gazebo/Blue</material>
        <sensor name="lidar_sensor" type="ray">
            <always_on>true</always_on>
            <visualize>false</visualize>
            <update_rate>10</update_rate>
            <pose>0 0 0 0 0 0</pose>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.12</min>
                    <max>10.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>

            <plugin name="gazebo_ros_laser_controller" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <remapping>~/out:=scan</remapping>
                </ros>
                <frame_name>lidar_link</frame_name>
                <output_type>sensor_msgs/LaserScan</output_type>
            </plugin>
        </sensor>
    </gazebo>

    <!-- GAZEBO ROS 2 CONTROL -->
    <gazebo>
        <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
            <parameters>$(find war_description)/config/my_controllers.yaml</parameters>
        </plugin>
    </gazebo>

</robot>
